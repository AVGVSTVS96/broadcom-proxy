{
  "listen": "127.0.0.1:8317",
  "accountOwner": true,
  "clientKeysFile": "~/.config/broadcom-proxy/secrets/client-keys",
  "managementKeyFile": "~/.config/broadcom-proxy/secrets/management-key",
  "credentialsDir": "~/.config/cliproxyapi/auths",
  "stateDir": "~/.local/state/cliproxyapi",
  "accountsFile": "~/.config/cliproxyapi/accounts.json",
  "apiKeys": [
    { "name": "team-credit", "keyFile": "~/.config/broadcom-proxy/secrets/api-key-team", "prefix": "included", "priority": 300 }
  ],
  "policy": { "sessionCutoff": 90, "weeklyCutoff": 98, "agentsPerAccount": 100 },
  "agentSdkFactor": 1.7,
  "resetCommand": "logger -t broadcom-proxy"
}
